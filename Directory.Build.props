<Project>

  <!--
    Shared settings for every project in the repository.

    The version lives here and nowhere else: the release workflow compares the
    pushed tag against this value, so a tag and a package can never disagree.
  -->

  <PropertyGroup>
    <Version>0.1.0</Version>

    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Reproducible output: the same source must produce the same bytes. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <Authors>Huuray A/S</Authors>
    <Company>Huuray A/S</Company>
    <Copyright>Copyright (c) 2026 Huuray A/S</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Huuray-A-S/huuray-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Huuray-A-S/huuray-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
