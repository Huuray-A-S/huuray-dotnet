<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>Huuray</RootNamespace>
    <AssemblyName>Huuray</AssemblyName>

    <!--
      Trimming and Native AOT friendly: every request and response goes through
      a source-generated System.Text.Json context, so nothing here needs
      reflection over model types at run time.
    -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Huuray</PackageId>
    <Title>Huuray — Huuray API v4 client</Title>
    <Description>Official .NET client for the Huuray API v4 — send digital gift cards and rewards to recipients in 170+ countries. Zero runtime dependencies, source-generated JSON, and money-safe defaults: orders are never retried automatically.</Description>
    <PackageTags>huuray;gift-card;giftcard;gift-cards;rewards;incentives;digital-rewards;vouchers;employee-rewards;api-client;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>avatar.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md at https://github.com/Huuray-A-S/huuray-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../.github/assets/avatar.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    No PackageReference of any kind: SourceLink is built into the .NET 8+ SDK
    (driven by PublishRepositoryUrl / EmbedUntrackedSources above), and the
    package itself has zero third-party runtime dependencies.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Huuray.Tests" />
  </ItemGroup>

</Project>
